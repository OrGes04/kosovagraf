---
/**
 * The whole experience on one page: a fixed stage (canvas + interface) and,
 * behind it, the scroll track. The track holds the story as real, readable
 * HTML, which is also what search engines, screen readers and visitors
 * without JavaScript get. Interface design: docs/design/ui.md.
 */
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/vt323/400.css';
import '../styles/story.css';
import { LOCALES } from '../lib/constants';
import { SCENE_SPAN, TITLE_SPAN } from '../engine/sequence';
import { imageUrl, pickWidth } from '../engine/renderer/types';
import { formatYear } from '../engine/hud/text';
import type { StoryData } from '../engine/types';

interface Props {
  data: StoryData;
}

const { data } = Astro.props;
const lang = data.locale;
const ui = data.ui[lang];
const lastScene = data.scenes.length - 1;
// "<" must not appear raw inside the JSON script block.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<a class="skip-link" href="#track" data-i18n="a11y.skipToContent">{ui.a11y.skipToContent}</a>

<div class="stage" id="stage">
  <canvas class="stage__canvas" id="gl" aria-hidden="true"></canvas>
  <div class="stage__fallback" id="fallback" hidden aria-hidden="true">
    <img alt="" /><img alt="" />
  </div>
  <div class="stage__shade" aria-hidden="true"></div>

  <!-- Title screen -->
  <div class="title" id="title">
    <h1 class="title__name" data-i18n="site.title">{ui.site.title}</h1>
    <p class="title__tagline" data-i18n="site.tagline">{ui.site.tagline}</p>
    <p class="title__hint">
      <span data-i18n="opening.scrollHint">{ui.opening.scrollHint}</span>
      <span class="title__arrow" aria-hidden="true"></span>
    </p>
  </div>

  <!-- Top right: one pill of controls -->
  <div class="controls" id="controls">
    <button class="icon-btn" id="btn-overview" type="button" data-i18n-label="controls.overview" aria-label={ui.controls.overview}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.6"></rect><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"></rect><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"></rect><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6"></rect></svg>
    </button>
    <button class="icon-btn" id="btn-sound" type="button" aria-pressed="false" data-i18n-label="controls.sound" aria-label={ui.controls.sound}>
      <svg class="when-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"></path><path d="M16 9.5l5 5M21 9.5l-5 5"></path></svg>
      <svg class="when-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"></path><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"></path></svg>
    </button>
    <button class="icon-btn" id="btn-effects" type="button" aria-pressed="true" data-i18n-label="controls.effects" aria-label={ui.controls.effects}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4.5l1.7 4.3 4.3 1.7-4.3 1.7L11 16.5l-1.7-4.3L5 10.5l4.3-1.7z"></path><path d="M17.5 14.5l.8 1.9 1.9.8-1.9.8-.8 1.9-.8-1.9-1.9-.8 1.9-.8z"></path></svg>
    </button>
    <div class="lang" role="group" data-i18n-label="controls.language" aria-label={ui.controls.language}>
      {
        LOCALES.map((code) => (
          <button type="button" data-lang={code} aria-pressed={code === lang ? 'true' : 'false'} data-i18n-label={`controls.${code}`} aria-label={ui.controls[code]}>
            {code.toUpperCase()}
          </button>
        ))
      }
    </div>
  </div>
  <p class="hints" id="hints" aria-hidden="true">
    <kbd>←</kbd><kbd>→</kbd> <span data-i18n="hints.scenes">{ui.hints.scenes}</span>
    <kbd class="hints__gap">O</kbd> <span data-i18n="hints.all">{ui.hints.all}</span>
  </p>

  <p class="badge" id="badge"></p>
  <p class="stamp" id="stamp" aria-hidden="true"></p>

  <!-- Bottom left: caption, meta line, mini timeline -->
  <div class="caption-block" id="caption-block">
    <!-- The same text is in the track below for assistive technology. -->
    <div class="captions" id="captions" aria-hidden="true">
      <p class="captions__text"></p>
    </div>
    <div class="meta">
      <span class="meta__roman" id="meta-roman"></span>
      <span class="meta__year" id="meta-year"></span>
      <span class="meta__name" id="meta-name"></span>
      <button class="meta__source" id="btn-source" type="button" aria-expanded="false" aria-controls="source">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h7l4 4v12H7z"></path><path d="M14 4v4h4M10 13h5M10 16h5"></path></svg>
        <span data-i18n="source.tab">{ui.source.tab}</span>
      </button>
    </div>
    <div class="mini" id="mini"></div>
  </div>

  <!-- Right edge: the time scrubber -->
  <div
    class="scrub"
    id="scrub"
    role="slider"
    tabindex="0"
    aria-orientation="vertical"
    aria-valuemin="0"
    aria-valuemax="100"
    data-i18n-label="scrubber.label"
    aria-label={ui.scrubber.label}
  >
    <span class="scrub__line"></span>
    <div class="scrub__marks"></div>
    <span class="scrub__handle"></span>
    <div class="scrub__bubble" aria-hidden="true">
      <img class="scrub__thumb" alt="" width="64" height="36" />
      <div class="scrub__text">
        <span class="scrub__year"></span>
        <span class="scrub__chapter"></span>
      </div>
    </div>
  </div>

  <!-- Chapter change -->
  <div class="chapter-card" id="chapter-card" hidden aria-hidden="true">
    <div class="chapter-card__inner">
      <div class="chapter-card__year"></div>
      <p class="chapter-card__label"><span class="chapter-card__number"></span><span class="chapter-card__name"></span></p>
    </div>
  </div>

  <!-- Overview -->
  <div class="overview" id="overview" hidden role="dialog" aria-modal="true" data-i18n-label="controls.overview" aria-label={ui.controls.overview} data-lenis-prevent>
    <div class="overview__top">
      <span class="overview__count"></span>
      <button class="icon-btn overview__close" type="button" data-i18n-label="overview.close" aria-label={ui.overview.close}>
        <kbd>Esc</kbd>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div class="overview__body"></div>
  </div>

  <!-- Sources -->
  <div class="source" id="source" hidden>
    <div class="source__backdrop"></div>
    <aside class="source__panel" role="dialog" data-i18n-label="source.tab" aria-label={ui.source.tab} data-lenis-prevent>
      <div class="source__top">
        <span class="source__kicker" data-i18n="source.tab">{ui.source.tab}</span>
        <button class="icon-btn source__close" type="button" data-i18n-label="source.close" aria-label={ui.source.close}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
      <div class="source__body"></div>
    </aside>
  </div>

  <!-- Opening -->
  <div class="opening" id="opening" hidden>
    <p class="opening__channel" aria-hidden="true">CH 01</p>
    <div class="opening__prompt">
      <p class="opening__question" data-i18n="opening.soundPrompt">{ui.opening.soundPrompt}</p>
      <div class="opening__choices">
        <button type="button" class="pill-btn pill-btn--solid" data-sound="on" data-i18n="opening.withSound">{ui.opening.withSound}</button>
        <button type="button" class="pill-btn" data-sound="off" data-i18n="opening.withoutSound">{ui.opening.withoutSound}</button>
      </div>
    </div>
    <div class="opening__counter" aria-hidden="true"><div class="opening__year"></div></div>
    <button type="button" class="opening__skip" data-i18n="opening.skip">{ui.opening.skip}</button>
  </div>
</div>

<main class="track" id="track" data-i18n-label="a11y.story" aria-label={ui.a11y.story}>
  <section class="track__item" data-item="title" data-scene="0" style={`--span:${TITLE_SPAN}`}></section>
  {
    data.scenes.map((scene, i) => (
      <article
        class="track__item scene"
        id={scene.id}
        data-item="scene"
        data-scene={i}
        style={`--span:${SCENE_SPAN + (i === lastScene ? 1 : 0)}`}
      >
        <div class="scene__copy">
          <p class="scene__meta">
            <span class="scene__year">{formatYear(scene.year, ui)}</span>
          </p>
          <h2 class="scene__title">{scene.title[lang]}</h2>
          <noscript>
            <img
              src={imageUrl(scene, pickWidth(scene.media.widths, 1600), 'webp')}
              alt={scene.imageAlt[lang]}
              width={scene.media.width}
              height={scene.media.height}
              loading="lazy"
            />
          </noscript>
          <p class="scene__alt">{scene.imageAlt[lang]}</p>
          <div class="scene__lines">
            {scene.subtitles[lang].map((line) => <p>{line}</p>)}
          </div>
          <p class="scene__credit">
            {scene.imageCredit} · {scene.imageLicenseDetail ?? ui.license[scene.imageLicense]}
          </p>
          {
            scene.sources.length > 0 && (
              <ul class="scene__sources">
                {scene.sources.map((s) => (
                  <li>
                    {s.url ? <a href={s.url} rel="noopener noreferrer">{s.title}</a> : s.title}
                    {[s.author, s.publisher, s.year].filter(Boolean).length > 0 &&
                      ` (${[s.author, s.publisher, s.year].filter(Boolean).join(', ')})`}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </article>
    ))
  }
</main>

<script type="application/json" id="story-data" set:html={json} />

<script>
  import '../engine/main';
</script>
