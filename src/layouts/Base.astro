---
import { DEFAULT_LOCALE, LOCALES, localePath, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const site = Astro.site;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Draft: keep search engines out until the owner says the site is ready to launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {
      site &&
        LOCALES.map((code) => <link rel="alternate" hreflang={code} href={new URL(localePath(code), site).href} />)
    }
    {site && <link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LOCALE), site).href} />}
    <script is:inline>
      document.documentElement.className = 'js';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    background: #000;
    color: #f1ece1;
    -webkit-font-smoothing: antialiased;
  }
</style>
