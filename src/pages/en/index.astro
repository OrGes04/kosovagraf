---
import Story from '../../components/Story.astro';
import Base from '../../layouts/Base.astro';
import { getStory } from '../../lib/story';

const data = await getStory('en');
const ui = data.ui.en;
---

<Base lang="en" title={`${ui.site.title} · ${ui.site.tagline}`} description={ui.site.description}>
  <Story data={data} />
</Base>
