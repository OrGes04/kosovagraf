---
import Story from '../components/Story.astro';
import Base from '../layouts/Base.astro';
import { getStory } from '../lib/story';

const data = await getStory('sq');
const ui = data.ui.sq;
---

<Base lang="sq" title={`${ui.site.title} · ${ui.site.tagline}`} description={ui.site.description}>
  <Story data={data} />
</Base>
